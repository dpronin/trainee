{
    "version": 10,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Ninja Multi-Config",
            "description": "Ninja Multi-Config generator",
            "generator": "Ninja Multi-Config",
            "environment": {
                "CXX": "clang++",
                "CXXFLAGS": "$penv{CXXFLAGS} -fdiagnostics-color=always",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            },
            "binaryDir": "${sourceDir}/.build"
        }
    ],
    "buildPresets": [
        {
            "name": ".default",
            "hidden": true,
            "verbose": true,
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "displayName": "Build (Debug)",
            "description": "Build Preset (Debug)",
            "inherits": ".default",
            "configuration": "Debug"
        },
        {
            "name": "relwithdebinfo",
            "displayName": "Build (RelWithDebInfo)",
            "description": "Build Preset (RelWithDebInfo)",
            "inherits": ".default",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "release",
            "displayName": "Build (Release)",
            "description": "Build Preset (Release)",
            "inherits": ".default",
            "configuration": "Release"
        }
    ],
    "workflowPresets": [
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "relwithdebinfo",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "relwithdebinfo"
                }
            ]
        },
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "release"
                }
            ]
        }
    ]
}
